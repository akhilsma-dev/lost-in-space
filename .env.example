# Copy to .env (git-ignored) and paste your key. demo/fake_demo.sh loads .env at start.
# ElevenLabs: speech-to-text for voice commands (voice.server) and voice.generate's callout clips.
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here
# Optional: voice for voice.generate (default: Adam)
# ELEVENLABS_VOICE_ID=
